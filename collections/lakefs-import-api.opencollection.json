{
  "opencollection": "1.0.0",
  "info": {
    "name": "lakeFS actions import API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "import",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "get import status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v1/repositories/:repository/branches/:branch/import",
            "params": [
              {
                "name": "repository",
                "value": "",
                "type": "path"
              },
              {
                "name": "branch",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "Unique identifier of the import process"
              }
            ]
          },
          "docs": "get import status"
        },
        {
          "info": {
            "name": "import data from object store",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/api/v1/repositories/:repository/branches/:branch/import",
            "params": [
              {
                "name": "repository",
                "value": "",
                "type": "path"
              },
              {
                "name": "branch",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "import data from object store"
        },
        {
          "info": {
            "name": "cancel ongoing import",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/api/v1/repositories/:repository/branches/:branch/import",
            "params": [
              {
                "name": "repository",
                "value": "",
                "type": "path"
              },
              {
                "name": "branch",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "Unique identifier of the import process"
              }
            ]
          },
          "docs": "cancel ongoing import"
        }
      ]
    }
  ],
  "bundled": true
}
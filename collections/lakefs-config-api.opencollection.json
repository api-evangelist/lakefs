{
  "opencollection": "1.0.0",
  "info": {
    "name": "lakeFS actions config API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "config",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getConfig",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v1/config"
          },
          "docs": "retrieve lakeFS configuration"
        }
      ]
    }
  ],
  "bundled": true
}
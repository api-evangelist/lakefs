        {
          "info": {
            "name": "Replay the changes from the given commit on the branch",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/api/v1/repositories/:repository/branches/:branch/cherry-pick",
            "params": [
              {
                "name": "repository",
                "value": "",
                "type": "path"
              },
              {
                "name": "branch",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Replay the changes from the given commit on the branch"
        },
        {
          "info": {
            "name": "diff branch",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v1/repositories/:repository/branches/:branch/diff",
            "params": [
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "return items after this value"
              },
              {
                "name": "amount",
                "value": "",
                "type": "query",
                "description": "how many items to return"
              },
              {
                "name": "prefix",
                "value": "",
                "type": "query",
                "description": "return items prefixed with this value"
              },
              {
                "name": "delimiter",
                "value": "",
                "type": "query",
                "description": "delimiter used to group common prefixes by"
              },
              {
                "name": "repository",
                "value": "",
                "type": "path"
              },
              {
                "name": "branch",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "diff branch"
        }
      ]
    }
  ],
  "bundled": true
}
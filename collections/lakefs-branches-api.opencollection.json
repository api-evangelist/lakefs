        {
          "info": {
            "name": "delete branch",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/api/v1/repositories/:repository/branches/:branch",
            "params": [
              {
                "name": "repository",
                "value": "",
                "type": "path"
              },
              {
                "name": "branch",
                "value": "",
                "type": "path"
              },
              {
                "name": "force",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "delete branch"
        },
        {
          "info": {
            "name": "revert",
            "type": "http"
